# Copy this file to .env and set the passwords. .env is gitignored.
# Do not put comments on the same line as a value (Docker treats them as part of the value).

# --- read by the web app ---
# Both logins use the warehouse's Oracle database. "oracle" is its container on
# the shared Docker network retail_default; XEPDB1 is the pluggable database.
DB_URL=jdbc:oracle:thin:@//oracle:1521/XEPDB1

# The portal's own schema (users, roles, schedules, export runs), created by bin/db-setup.sh.
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=ChangeMePortal1
PORTAL_DB_POOL_SIZE=2

# The warehouse's read-only reporting user: it can only SELECT the 12 DW.V_RPT_* views.
# Copy REPORT_USER / REPORT_PASSWORD from the warehouse repo's .env (../retail/.env).
WAREHOUSE_DB_USER=dw_report
WAREHOUSE_DB_PASSWORD=ChangeMeReport1
WAREHOUSE_SCHEMA=DW
WAREHOUSE_DB_POOL_SIZE=5

# Folder inside the container; docker-compose.yml mounts ./exports there.
PORTAL_EXPORT_DIR=/exports
# Time zone of the "daily at HH:MM" export times and of times shown on screen.
PORTAL_TIME_ZONE=UTC
PORTAL_SCHEDULER_INTERVAL_SECONDS=30

# --- read only by bin/db-setup.sh and docker-compose.yml ---
ORACLE_CONTAINER=retail-oracle-1
WAREHOUSE_NETWORK=retail_default
